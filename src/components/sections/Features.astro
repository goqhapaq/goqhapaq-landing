---
const features = [
  {
    image: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=800&q=80',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />`,
    title: 'Análisis Inteligente',
    description: 'Algoritmos avanzados evalúan clima, altitud, peligros y condiciones en tiempo real'
  },
  {
    image: 'https://images.unsplash.com/photo-1534088568595-a066f410bcda?w=800&q=80',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />`,
    title: 'Clima en Tiempo Real',
    description: 'Información meteorológica actualizada y alertas de condiciones adversas'
  },
  {
    image: 'https://images.unsplash.com/photo-1519904981063-b0cf448d479e?w=800&q=80',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />`,
    title: 'Alertas de Peligro',
    description: 'Notificaciones sobre derrumbes, zonas de riesgo y condiciones peligrosas'
  },
  {
    image: 'https://images.unsplash.com/photo-1524661135-423995f22d0b?w=800&q=80',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`,
    title: 'Mapas Offline',
    description: 'Descarga mapas y navega sin conexión en zonas remotas sin señal'
  },
  {
    image: 'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?w=800&q=80',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`,
    title: 'Comunidad Activa',
    description: 'Comparte experiencias, fotos y recomendaciones con exploradores'
  },
  {
    image: 'https://images.unsplash.com/photo-1476900543704-4312b78632f8?w=800&q=80',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />`,
    title: 'Tracking GPS',
    description: 'Sigue tu progreso en tiempo real y comparte tu ubicación'
  }
];
---

<section id="features" class="section-padding bg-gradient-to-b from-qhapaq-dark-950 to-black relative overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-1/4 left-0 w-96 h-96 bg-qhapaq-terracota-600 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 right-0 w-96 h-96 bg-qhapaq-terracota-800 rounded-full blur-3xl"></div>
  </div>

  <div class="container-custom relative z-10">
    <div class="max-w-3xl mx-auto text-center mb-20 reveal-on-scroll">
      <div class="inline-block px-4 py-2 rounded-full bg-qhapaq-terracota-500/10 border border-qhapaq-terracota-500/20 mb-6">
        <span class="text-qhapaq-terracota-400 font-semibold text-sm">Características</span>
      </div>
      
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold mb-6">
        Todo lo que necesitas para
        <span class="gradient-text"> explorar con confianza</span>
      </h2>
      
      <p class="text-xl text-gray-400 text-balance">
        Herramientas poderosas diseñadas para transformar cada viaje en una experiencia segura e inolvidable.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {features.map((feature, index) => (
        <div 
          class="group relative reveal-on-scroll overflow-hidden rounded-2xl"
          style={`animation-delay: ${index * 0.05}s;`}
        >
          <div class="relative h-80 overflow-hidden">
            <img 
              src={feature.image} 
              alt={feature.title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent"></div>
            
            <div class="absolute top-4 left-4">
              <div class="w-12 h-12 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <Fragment set:html={feature.icon} />
                </svg>
              </div>
            </div>

            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h3 class="text-2xl font-display font-bold mb-2 text-white">{feature.title}</h3>
              <p class="text-gray-300 text-sm leading-relaxed">{feature.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-20 text-center reveal-on-scroll">
      <a href="#beta" class="btn-primary inline-flex items-center">
        Comienza a explorar
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>
