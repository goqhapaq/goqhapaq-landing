---
---

<section id="beta" class="section-padding bg-gradient-to-b from-black to-qhapaq-dark-950 relative overflow-hidden">
  <div class="absolute inset-0">
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-qhapaq-terracota-600/20 rounded-full blur-3xl"></div>
  </div>

  <div class="container-custom relative z-10">
    <div class="max-w-4xl mx-auto">
      <div class="glass-effect rounded-3xl p-8 md:p-16 border-2 border-qhapaq-terracota-500/20 text-center reveal-on-scroll">
        <div class="inline-flex items-center px-4 py-2 rounded-full bg-qhapaq-terracota-500/10 border border-qhapaq-terracota-500/20 mb-8">
          <span class="w-2 h-2 bg-qhapaq-terracota-500 rounded-full mr-2 animate-pulse"></span>
          <span class="text-sm font-semibold text-qhapaq-terracota-400">Beta Limitado</span>
        </div>

        <h2 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold mb-6">
          Sé parte de la
          <span class="gradient-text"> revolución</span>
        </h2>

        <p class="text-xl text-gray-300 mb-12 max-w-2xl mx-auto text-balance">
          Únete a nuestro programa beta y sé de los primeros en experimentar el futuro de la exploración en LATAM.
        </p>

        <form class="max-w-md mx-auto mb-8" id="beta-form">
          <div class="flex flex-col sm:flex-row gap-4">
            <input
              type="email"
              placeholder="tu@email.com"
              required
              class="flex-1 px-6 py-4 rounded-full bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-qhapaq-terracota-500 focus:border-transparent transition-all"
            />
            <button
              type="submit"
              class="btn-primary whitespace-nowrap"
            >
              Unirse al Beta
            </button>
          </div>
          <p class="text-sm text-gray-400 mt-4">
            Cupos limitados. Te notificaremos cuando estés dentro.
          </p>
        </form>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-12 border-t border-white/10">
          <div class="text-center">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-qhapaq-terracota-500/10 flex items-center justify-center">
              <svg class="w-8 h-8 text-qhapaq-terracota-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h3 class="font-display font-semibold mb-2">Acceso Anticipado</h3>
            <p class="text-sm text-gray-400">Prueba funcionalidades antes que nadie</p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-qhapaq-terracota-500/10 flex items-center justify-center">
              <svg class="w-8 h-8 text-qhapaq-terracota-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
              </svg>
            </div>
            <h3 class="font-display font-semibold mb-2">Beneficios Exclusivos</h3>
            <p class="text-sm text-gray-400">Descuentos y ventajas de por vida</p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-qhapaq-terracota-500/10 flex items-center justify-center">
              <svg class="w-8 h-8 text-qhapaq-terracota-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
              </svg>
            </div>
            <h3 class="font-display font-semibold mb-2">Influye en el Producto</h3>
            <p class="text-sm text-gray-400">Tu feedback moldea Qhapaq</p>
          </div>
        </div>
      </div>

      <div class="mt-16 text-center reveal-on-scroll" style="animation-delay: 0.2s;">
        <p class="text-gray-400 mb-4">Síguenos en redes sociales</p>
        <div class="flex justify-center space-x-4">
          <a href="#" class="w-12 h-12 rounded-full glass-effect hover:bg-qhapaq-terracota-600 flex items-center justify-center transition-all duration-300 transform hover:scale-110" aria-label="Twitter">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
            </svg>
          </a>
          <a href="#" class="w-12 h-12 rounded-full glass-effect hover:bg-qhapaq-terracota-600 flex items-center justify-center transition-all duration-300 transform hover:scale-110" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" />
            </svg>
          </a>
          <a href="#" class="w-12 h-12 rounded-full glass-effect hover:bg-qhapaq-terracota-600 flex items-center justify-center transition-all duration-300 transform hover:scale-110" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('beta-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = (e.target as HTMLFormElement).querySelector('input[type="email"]') as HTMLInputElement;
    
    alert(`¡Gracias por tu interés! Te notificaremos a ${email.value} cuando el beta esté disponible.`);
    email.value = '';
  });
</script>
